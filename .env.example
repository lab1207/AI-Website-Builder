# Optional. The absolute URL where this site is hosted.
# Used at build time for canonical, Open Graph, and Twitter tags.
# Vercel, Netlify, Cloudflare Pages, and GitHub Pages are detected
# automatically. Set this only for a custom domain or to override them.
#
# VITE_SITE_URL=https://your-domain.example

# Optional. A Gemini API key embedded in the build.
#
# Prefer adding your key in the app instead. A key set here is included in
# the published bundle, so anyone who opens the site can read it. Only use
# this for a private deployment you control.
#
# VITE_GEMINI_API_KEY=your-key-here
